# 复制本文件为 .env 并填入你自己的 key
#   cp .env.example .env
# .env 已被 .gitignore 排除，绝不提交。

# 任何 OpenAI 兼容端点都可以（MiniMax / DeepSeek / 其它）
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_MODEL=MiniMax-M2
LLM_API_KEY=your-key-here

# 说明：
# - MiniMax-M2.x 会忽略 enable_thinking=false，思维链关不掉。
#   代码里已强制 reasoning_split: true，把推理分离到 reasoning_content。
#   换别的模型若 content 里出现 <think> 块，strip_think() 会兜底剥离。
# - 不配置本文件也能跑：叙事层会自动降级为模板，所有测试照常通过。
